{
  "name": "fitcheck-web",
  "private": true,
  "version": "0.1.0",
  "description": "FitCheck's phone app: scan or link a garment, see it on you, and get BUY, SKIP or TRY-WITH against your closet, weather and plans.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HackedRico/FitCheck.git",
    "directory": "web"
  },
  "homepage": "https://github.com/HackedRico/FitCheck#readme",
  "bugs": {
    "url": "https://github.com/HackedRico/FitCheck/issues"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9",
    "vite": "^8.3.2"
  }
}
