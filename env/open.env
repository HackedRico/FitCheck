# Open path: open-weight models over OpenAI-compatible APIs and try-on, data in Postgres.
# Model endpoints default to Featherless; point FITCHECK_VISION_BASE_URL and
# FITCHECK_CHAT_BASE_URL at your own server in engine/.env to keep them on your hardware.
# Secrets and per-machine values (API keys, HF_TOKEN, iCal URL) go in engine/.env, which git ignores.
FITCHECK_STORE=postgres
FITCHECK_TAGGER=openai_compat
FITCHECK_CUTOUT=rembg
# Leffa on a public Hugging Face Space; HF_TOKEN in engine/.env raises its GPU quota
FITCHECK_TRYON=hf_space
FITCHECK_TRYON_FALLBACK=overlay
FITCHECK_WEATHER=open_meteo
FITCHECK_CALENDAR=fixture
FITCHECK_STYLIST=openai_compat
