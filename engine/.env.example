# Copy to engine/.env (git ignores it) and fill in what you use. Everything is optional:
# with nothing set, the engine runs offline on fakes and a demo week.

# ---------- adapter slots ----------
# FITCHECK_STORE=memory            # memory | postgres | snowflake
# FITCHECK_TAGGER=fake             # fake | openai_compat
# FITCHECK_CUTOUT=none             # none | rembg (runs locally, 170 MB model on first use)
# FITCHECK_TRYON=overlay           # overlay | hf_space | remote
# FITCHECK_WEATHER=fixture         # fixture | open_meteo (no key needed)
# FITCHECK_CALENDAR=fixture        # none | fixture | ics
# FITCHECK_STYLIST=template        # template | openai_compat | cortex

# ---------- open-weight models over an OpenAI-compatible API ----------
# Featherless by default; for your own server use e.g. http://localhost:11434/v1 (Ollama)
FITCHECK_VISION_BASE_URL=https://api.featherless.ai/v1
FITCHECK_VISION_API_KEY=
FITCHECK_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
FITCHECK_CHAT_BASE_URL=https://api.featherless.ai/v1
FITCHECK_CHAT_API_KEY=
FITCHECK_CHAT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# ---------- try-on ----------
# HF_TOKEN=                        # free Hugging Face read token, raises the hf_space GPU quota
# FITCHECK_TRYON_WORKER_URL=       # our own GPU worker, for FITCHECK_TRYON=remote
# FITCHECK_TRYON_WORKER_TOKEN=

# ---------- calendar ----------
# FITCHECK_CALENDAR_ICS_URL=       # Google Calendar "secret address in iCal format"

# ---------- Snowflake (see docs/snowflake.md) ----------
# FITCHECK_SNOWFLAKE_ACCOUNT=
# FITCHECK_SNOWFLAKE_USER=
# FITCHECK_SNOWFLAKE_PASSWORD=
# FITCHECK_SNOWFLAKE_ROLE=FITCHECK
# FITCHECK_CORTEX_MODEL=llama3.3-70b
