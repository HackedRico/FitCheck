# Copy to engine/.env (git ignores it) and fill in what you use. Everything is optional:
# with nothing set, the engine runs offline on fakes and a demo week.

# ---------- adapter slots ----------
# FITCHECK_STORE=sqlite           # sqlite | memory | postgres | snowflake
# FITCHECK_TAGGER=fake             # fake | openai_compat
# FITCHECK_CUTOUT=none             # none | rembg (runs locally, 170 MB model on first use)
# FITCHECK_TRYON=overlay           # overlay | hf_space | remote
# FITCHECK_TRYON_FALLBACK=none     # none | overlay | hf_space | remote, used while FITCHECK_TRYON is unavailable
# FITCHECK_WEATHER=fixture         # fixture | open_meteo (no key needed)
# FITCHECK_CALENDAR=fixture        # none | fixture | ics
# FITCHECK_STYLIST=template        # template | openai_compat | cortex

# ---------- engine ----------
# FITCHECK_DATA_DIR=.fitcheck       # closet database and garment images, relative to the repo root
# FITCHECK_SEED_PATH=demo/closet.json  # loaded into an empty closet; set empty to skip
# FITCHECK_DEFAULT_OWNER=ricky
# FITCHECK_DEFAULT_LATITUDE=40.7128   # used when a client sends no location
# FITCHECK_DEFAULT_LONGITUDE=-74.0060
# FITCHECK_DEFAULT_LOCATION_NAME=New York
# FITCHECK_FORECAST_DAYS=7
# FITCHECK_CORS_ORIGINS=["http://localhost:5173","https://localhost:5173"]
# FITCHECK_CORS_ORIGIN_REGEX=       # extra allowed origins, e.g. a tunnel hostname
# FITCHECK_DATABASE_URL=postgresql://fitcheck:fitcheck@localhost:5432/fitcheck  # for FITCHECK_STORE=postgres

# ---------- open-weight models over an OpenAI-compatible API ----------
# Featherless by default; for your own server use e.g. http://localhost:11434/v1 (Ollama).
# Leave a key empty for a server that needs none.
FITCHECK_VISION_BASE_URL=https://api.featherless.ai/v1
FITCHECK_VISION_API_KEY=
FITCHECK_VISION_MODEL=Qwen/Qwen3-VL-8B-Instruct
FITCHECK_CHAT_BASE_URL=https://api.featherless.ai/v1
FITCHECK_CHAT_API_KEY=
FITCHECK_CHAT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# FITCHECK_LLM_TIMEOUT_S=60
# FITCHECK_VISION_RUNS_ON=         # this_machine | public_api | snowflake, shown in /health; guessed from the URL when unset
# FITCHECK_CHAT_RUNS_ON=

# ---------- try-on ----------
# HF_TOKEN=                        # free Hugging Face read token, raises the hf_space GPU quota
# FITCHECK_TRYON_HF_SPACE=franciszzj/Leffa
# FITCHECK_TRYON_TIMEOUT_S=180
# FITCHECK_TRYON_WORKER_URL=       # our own GPU worker, for FITCHECK_TRYON=remote
# FITCHECK_TRYON_WORKER_TOKEN=
# FITCHECK_TRYON_FALLBACK_COOLDOWN_S=300  # seconds to skip a failed try-on adapter before trying it again

# ---------- calendar ----------
# FITCHECK_CALENDAR_ICS_URL=       # Google Calendar "secret address in iCal format"

# ---------- Snowflake (see docs/snowflake.md) ----------
# FITCHECK_SNOWFLAKE_ACCOUNT=
# FITCHECK_SNOWFLAKE_USER=
# FITCHECK_SNOWFLAKE_PRIVATE_KEY_PATH=  # key pair sign-in; most accounts block password-only
# FITCHECK_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=  # only for an encrypted key file
# FITCHECK_SNOWFLAKE_PASSWORD=     # used only when no key path is set
# FITCHECK_SNOWFLAKE_ROLE=FITCHECK
# FITCHECK_SNOWFLAKE_WAREHOUSE=FITCHECK_WH
# FITCHECK_SNOWFLAKE_DATABASE=FITCHECK
# FITCHECK_SNOWFLAKE_SCHEMA=PUBLIC
# FITCHECK_CORTEX_MODEL=llama3.3-70b
# FITCHECK_CORTEX_SEARCH_SERVICE=CLOSET_SEARCH
