# Snowflake path: closet and retrieval in Snowflake, stylist on Cortex.
# Garment vision and try-on stay on hosted open weights, so person photos never reach Snowflake.
# Put FITCHECK_SNOWFLAKE_ACCOUNT, _USER and _PASSWORD (or _PRIVATE_KEY_PATH) in engine/.env.
FITCHECK_STORE=snowflake
FITCHECK_TAGGER=openai_compat
FITCHECK_CUTOUT=rembg
FITCHECK_TRYON=remote
FITCHECK_WEATHER=open_meteo
FITCHECK_CALENDAR=fixture
FITCHECK_STYLIST=cortex
