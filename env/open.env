# Open path: every model on open weights you host, data in Postgres. No accounts.
# Secrets and per-machine values (worker URL, iCal URL) go in engine/.env, which git ignores.
FITCHECK_STORE=postgres
FITCHECK_TAGGER=ollama
FITCHECK_CUTOUT=rembg
FITCHECK_TRYON=remote
FITCHECK_WEATHER=open_meteo
FITCHECK_CALENDAR=fixture
FITCHECK_STYLIST=ollama
